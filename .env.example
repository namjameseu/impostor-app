# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml.
POSTGRES_DB=impostor
POSTGRES_USER=impostor
# Local development only - use a real secret anywhere else.
POSTGRES_PASSWORD=impostor

# Host ports
POSTGRES_PORT=5440
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173

# Admin passcode for the word library: hides the words and locks editing. Empty = open.
ADMIN_PASSCODE=impostor-app
